---
import StrokeIcon from '@/components/icons/StrokeIcon.astro';

interface Props {
  direction?: 'external' | 'right' | 'left';
  class?: string;
}
const { direction = 'external', class: className = '' } = Astro.props;
const names = { external: 'external', right: 'arrow-right', left: 'arrow-left' } as const;
---

<StrokeIcon name={names[direction]} class:list={['arrow-icon', `arrow-icon--${direction}`, className]} />

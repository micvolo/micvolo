<button class="palette-toggle" type="button" data-palette-toggle role="switch" aria-checked="true" aria-label="Use greyscale shader palette" title="Use greyscale shader palette">
  <span class="palette-toggle__track" aria-hidden="true"><i></i></span>
</button>

<style>
  .palette-toggle {
    flex: 0 0 auto;
    width: calc(var(--ctl) * 1.6 + 2px);
    min-width: calc(var(--ctl) * 1.6 + 2px);
    min-height: var(--ctl);
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    border-radius: var(--pill);
  }
  .palette-toggle__track {
    position: relative;
    width: calc(var(--ctl) * 1.6);
    height: var(--ctl);
    border-radius: var(--pill);
    background: var(--fill-3);
    box-shadow: inset 0 0 0 .5px rgba(0, 0, 0, .08);
    transition: background-color .28s cubic-bezier(.32, .72, 0, 1);
  }
  .palette-toggle[aria-checked="true"] .palette-toggle__track { background: var(--accent); }
  .palette-toggle__track i {
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(var(--ctl) - 4px);
    height: calc(var(--ctl) - 4px);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 3px 8px rgba(0, 0, 0, .15), 0 1px 2px rgba(0, 0, 0, .28);
    transition: transform .28s cubic-bezier(.32, .72, 0, 1), width .18s cubic-bezier(.32, .72, 0, 1);
  }
  .palette-toggle[aria-checked="true"] .palette-toggle__track i { transform: translateX(calc(var(--ctl) * .6)); }

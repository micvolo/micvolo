<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';
  import { animate } from 'motion/mini';

  let lenis: Lenis | undefined;
  let railLenis: Lenis | undefined;
  let animations: ReturnType<typeof animate>[] = [];
  let initialized = false;
  let initialPageLoadHandled = false;

  function initRuntime() {
    if (initialized) return;
    initialized = true;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const publicPage = document.querySelector<HTMLElement>('.page');

    if (publicPage && !lenis) {
      lenis = new Lenis({
        autoRaf: true,
        anchors: true,
        smoothWheel: true,
        lerp: 0.085,
        stopInertiaOnNavigate: true,
        respectReducedMotion: true,
        prevent: (node) => Boolean(node.closest?.('.rail')),
      });
    }

    const rail = document.querySelector<HTMLElement>('.rail');
    const railContent = rail?.querySelector<HTMLElement>('[data-rail-content]');
    if (rail && railContent && !railLenis && window.matchMedia('(min-width: 901px)').matches) {
      railLenis = new Lenis({
        wrapper: rail,
        content: railContent,
        eventsTarget: rail,
        autoRaf: true,
        smoothWheel: true,
        lerp: 0.16,
        wheelMultiplier: 0.9,
        overscroll: true,
        respectReducedMotion: true,
      });
    }

    if (!reduceMotion && publicPage) {
      animations.push(animate(publicPage, { opacity: [0.96, 1] }, { duration: 0.18, ease: 'easeOut' }));
    }

    if (!reduceMotion) {
      document.querySelectorAll<HTMLElement>('.progress-track > i').forEach((bar) => {
        animations.push(animate(bar, { transform: ['scaleX(0)', 'scaleX(1)'] }, {
          duration: 0.55,
          ease: [0.22, 1, 0.36, 1],
        }));
        bar.style.transformOrigin = 'left center';
      });
    }
  }

  function destroyRuntime() {
    initialized = false;
    lenis?.destroy();
    lenis = undefined;
    railLenis?.destroy();
    railLenis = undefined;
    animations.forEach((animation) => animation.stop());
    animations = [];
  }

  // Focus management: after a client-side route change the previously focused
  // element is gone and focus falls back to body. Move it to the new main content
  // unless focus survived inside a persisted region (the rail) or the URL points
  // at an in-page anchor (the browser already sets the focus start there).
  function manageFocus() {
    if (!initialPageLoadHandled) {
      initialPageLoadHandled = true;
      return;
    }
    const active = document.activeElement;
    if (active && active !== document.body) return;
    if (window.location.hash) return;
    const main = document.querySelector<HTMLElement>('main');
    if (!main) return;
    if (main.tabIndex < 0) main.tabIndex = -1;
    main.focus({ preventScroll: true });
  }

  // One initialization entry point per page with cleanup on astro:before-swap.
  document.addEventListener('astro:page-load', () => {
    initRuntime();
    manageFocus();
  });
  document.addEventListener('astro:before-swap', destroyRuntime);
  window.addEventListener('pagehide', destroyRuntime);
  // bfcache restores skip the astro lifecycle: rebuild the runtime on return.
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) initRuntime();
  });
</script>

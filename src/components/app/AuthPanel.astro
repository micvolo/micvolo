---
// Single email-based access point for clients and for the studio. The server
// derives the role from the email address, so the form carries no role.
interface Props {
  sent: boolean;
  error: boolean;
  preview?: string;
}
const { sent, error, preview } = Astro.props;
---
<main id="main" class="auth-pane">
  <section class="auth-stack" aria-labelledby="auth-title">
    <h1 id="auth-title">Client &amp; studio access</h1>
    <p class="muted">Use the email linked to your project or to the studio. The address decides where you land</p>
    {sent ? (
      <>
        <p class="muted" role="status">If the address is authorised, a six-digit code is on its way</p>
        {preview && <div class="preview-code"><span>Local preview</span><strong>{preview}</strong></div>}
        <form method="post" action="/api/auth/verify-code" class="stack-form" data-verify-form data-auto-code={preview}>
          <label for="code">Access code</label>
          <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus />
          {error && <p class="form-error" role="alert">That code is invalid or has expired</p>}
          <button type="submit">Continue</button>
        </form>
      </>
    ) : (
      <form method="post" action="/api/auth/request-code" class="stack-form">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="email" required autofocus />
        <button type="submit">Email me a code</button>
      </form>
    )}
  </section>
</main>

<script>
  // Dev preview only: fill and submit the one-time-code form with the previewed
  // code. Bundled (not inline) so the site CSP allows it, and bound on
  // astro:page-load so it also runs after client-side swaps. Guarded so the
  // auto-submit fires once per form.
  function submitAutoCode() {
    const form = document.querySelector<HTMLFormElement>('form[data-verify-form][data-auto-code]');
    if (!form) return;
    const autoCode = form.dataset.autoCode ?? '';
    if (form.dataset.autoCodeDone === 'true' || !/^\d{6}$/.test(autoCode)) return;
    form.dataset.autoCodeDone = 'true';
    const input = form.querySelector<HTMLInputElement>('input[name="code"]');
    if (input) input.value = autoCode;
    form.requestSubmit();
  }

  document.addEventListener('astro:page-load', submitAutoCode);
  if (document.readyState !== 'loading') submitAutoCode();
</script>

---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { limit?: number; }
const { limit } = Astro.props;
const projects = (await getCollection('projects')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const visible = typeof limit === 'number' ? projects.slice(0, limit) : projects;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{webp,png,jpg,jpeg,avif}', { eager: true });
const imageFor = (path: string) => images[`/src/assets/projects/${path.split('/').pop()}`]?.default;
---
<ol class="project-list">
  {visible.map((project, index) => (
    <li>
      <a href={`/work/${project.id}`} class="project-row">
        <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
        <span class="project-image">
          <Image src={imageFor(project.data.image)} alt="" widths={[480, 800, 1200]} sizes="(max-width: 720px) 92vw, 46vw" format="webp" quality={78} loading={index < 2 ? 'eager' : 'lazy'} />
        </span>
        <span class="project-title">{project.data.title}</span>
        <span class="project-type">{project.data.tags}</span>
        <time datetime={project.data.date.toISOString()}>{project.data.date.getFullYear()}</time>
      </a>
    </li>
  ))}
</ol>

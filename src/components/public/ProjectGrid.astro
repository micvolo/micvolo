---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
interface Props { limit?: number; }
const { limit } = Astro.props;
const projects = (await getCollection('projects'))
  .filter((project) => !['graphic-experiments', 'letter-flow', 'camaleonte', 'reazione-a-catena'].includes(project.data.slug ?? ''))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const visible = typeof limit === 'number' ? projects.slice(0, limit) : projects;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{webp,png,jpg,jpeg,avif}', { eager: true });
const imageFor = (path: string) => images[`/src/assets/projects/${path.split('/').pop()}`]?.default;
---
<ol class="project-list">
  {visible.map((project, index) => {
    const isNative = project.data.kind === 'native' && project.data.slug;
    const isExternal = !isNative;
    let href = project.data.url ?? '#';
    if (isNative && project.data.slug) {
      if (project.data.category === 'lab') href = `/graphic-experiments`;
      else if (project.data.category === 'game') href = `/table-games/${project.data.slug}`;
      else href = `/projects/${project.data.slug}`;
    }
    return (
      <li>
        <a href={href} class="work-card" {...(isExternal ? { target: '_blank', rel: 'noreferrer' } : {})} aria-label={`${project.data.title} — ${project.data.tags}${isExternal ? ', opens in a new tab' : ''}`}>
          <figure class="work-card__media">
            <Image src={imageFor(project.data.image)} alt="" widths={[480, 800, 1200]} sizes="(max-width: 720px) calc(100vw - 32px), 50vw" format="webp" quality={82} loading={index < 2 ? 'eager' : 'lazy'} />
          </figure>
          <div class="work-card__foot">
            <span class="work-card__title">{project.data.title}<ArrowIcon direction={isExternal ? 'external' : 'right'} /></span>
            <span class="work-card__meta">{project.data.tags} · <time datetime={project.data.date.toISOString()}>{project.data.date.getFullYear()}</time></span>
          </div>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .project-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s2);
    margin: 0;
    padding: 0;
  }
  .work-card {
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--glass-surface);
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-1);
    box-shadow: var(--glass-shadow);
    transition: background-color var(--t-color) var(--ease), border-color var(--t-color) var(--ease), box-shadow .3s var(--ease), transform .3s var(--ease);
  }
  @supports (backdrop-filter: blur(1px)) {
    .work-card { backdrop-filter: blur(28px) saturate(114%); -webkit-backdrop-filter: blur(28px) saturate(114%); }
  }
  .work-card__media { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--r-1) var(--r-1) 0 0; }
  .work-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .work-card__foot { min-height: 68px; display: flex; flex-direction: column; justify-content: space-between; gap: var(--s3); padding: var(--s3) var(--s4) var(--s4); }
  .work-card__title { font-family: var(--font-display); font-size: var(--f-lead); font-weight: 400; line-height: 1.3; letter-spacing: .25px; }
  .work-card__meta { color: var(--ink-3); font-size: var(--f-small); }
  @media (hover: hover) {
    .work-card:hover { background: var(--fill-2); border-color: color-mix(in srgb, var(--accent) 34%, var(--glass-edge)); box-shadow: 0 18px 46px color-mix(in srgb, var(--accent) 8%, transparent); }
  }
  @media (min-width: 721px) {
    .project-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .work-card__foot { min-height: 72px; }
    .work-card__title { line-height: 1.35; letter-spacing: .15px; }
  }
</style>

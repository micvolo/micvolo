---
import { Image } from 'astro:assets';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { getProjects } from '@/lib/projects';
interface Props { limit?: number; }
const { limit } = Astro.props;
const projects = await getProjects();
const visible = typeof limit === 'number' ? projects.slice(0, limit) : projects;
---
<ol class="project-list">
  {visible.map((project, index) => (
    <li>
      <a href={`/projects/${project.slug}`} class="work-card" aria-label={`${project.title} — ${project.tags}`}>
        <figure class="work-card__media">
          <Image src={project.cover} alt="" widths={[480, 800, 1200]} sizes="(max-width: 720px) calc(100vw - 32px), 50vw" format="webp" quality={82} loading={index < 2 ? 'eager' : 'lazy'} />
        </figure>
        <div class="work-card__foot">
          <span class="work-card__title">{project.title}<ArrowIcon direction="right" /></span>
          <span class="work-card__meta">{project.tags} · <time datetime={project.date.toISOString()}>{project.date.getFullYear()}</time></span>
        </div>
      </a>
    </li>
  ))}
</ol>

<style>
  .project-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s2);
    margin: 0;
    padding: 0;
  }
  .work-card {
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--glass-surface);
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-1);
    box-shadow: var(--glass-shadow);
    transition: background-color var(--t-color) var(--ease), border-color var(--t-color) var(--ease), box-shadow .3s var(--ease), transform .3s var(--ease);
  }
  @supports (backdrop-filter: blur(1px)) {
    .work-card { backdrop-filter: blur(28px) saturate(114%); -webkit-backdrop-filter: blur(28px) saturate(114%); }
  }
  .work-card__media { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--r-1) var(--r-1) 0 0; }
  .work-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .work-card__foot { min-height: 68px; display: flex; flex-direction: column; justify-content: space-between; gap: var(--s3); padding: var(--s3) var(--s4) var(--s4); }
  .work-card__title { font-family: var(--font-display); font-size: var(--f-lead); font-weight: 400; line-height: 1.3; letter-spacing: .25px; }
  .work-card__meta { color: var(--ink-3); font-size: var(--f-small); }
  @media (hover: hover) {
    .work-card:hover { background: var(--fill-2); border-color: color-mix(in srgb, var(--accent) 34%, var(--glass-edge)); box-shadow: 0 18px 46px color-mix(in srgb, var(--accent) 8%, transparent); }
  }
  @media (min-width: 721px) {
    .project-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .work-card__foot { min-height: 72px; }
    .work-card__title { line-height: 1.35; letter-spacing: .15px; }
  }
</style>

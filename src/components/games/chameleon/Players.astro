---
import StrokeIcon from '@/components/icons/StrokeIcon.astro';

const DEFAULT_NAMES = ['Player 1', 'Player 2', 'Player 3', 'Player 4'];
---

<fieldset class="players">
  <legend class="section-label">Players <span>(minimum 3)</span></legend>
  <div class="list">
    {DEFAULT_NAMES.map((name, i) => (
      <label class="player-field"><span class="sr-only">Player {i + 1}</span><input type="text" placeholder={`Player ${i + 1}`} value={name} autocomplete="off" data-default="true" /></label>
    ))}
  </div>
  <div class="add-player">
    <label for="player-add" class="sr-only">New player name</label>
    <input type="text" id="player-add" placeholder="New player name" class="add" autocomplete="off" />
    <button type="button" class="add-player-button game-action"><StrokeIcon name="plus" /><span>Add player</span></button>
  </div>
</fieldset>
<button class="done primary-action game-action game-action--primary"><StrokeIcon name="play" /><span>Start game</span></button>

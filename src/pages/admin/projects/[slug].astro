---
export const prerender = false;
import { env as cloudflareEnv } from 'cloudflare:workers';
import PublicLayout from '@/layouts/PublicLayout.astro';
import SiteRail from '@/components/public/SiteRail.astro';
import AppShell from '@/components/app/AppShell.astro';
import ProjectPage from '@/components/app/ProjectPage.astro';
import { getProjects, type AdminProject } from '@/lib/admin/store';

const principal = Astro.locals.principal;
if (!principal) return Astro.redirect('/admin/login');
if (principal.role !== 'admin') return Astro.redirect('/portal');
const projects: AdminProject[] = await getProjects(cloudflareEnv.DB);
const project = projects.find((item) => item.slug === Astro.params.slug);
if (!project) return new Response('Progetto non trovato', { status: 404 });
---
<PublicLayout title={project.title}>
  <SiteRail />
  <AppShell back={{ href: '/admin', label: 'Tutti i progetti' }}>
    <div class="workspace"><ProjectPage {project} /></div>
  </AppShell>
</PublicLayout>

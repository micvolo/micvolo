---
import { env as cloudflareEnv } from 'cloudflare:workers';
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppShell from '@/components/app/AppShell.astro';
import { formatHours, formatMoney, type ProjectSummary, type WorklogRow, type DocumentRow, type InvoiceRow } from '@/lib/db';
const principal = Astro.locals.principal;
if (!principal) return Astro.redirect('/admin/login');
if (principal.role !== 'admin') return Astro.redirect('/portal');
const { id } = Astro.params;
const db = cloudflareEnv.DB;
const project = await db.prepare(`SELECT p.*, u.display_name AS client_name, u.email AS client_email,
  COALESCE((SELECT SUM(w.minutes) FROM worklogs w WHERE w.project_id = p.id), 0) AS worked_minutes,
  COALESCE((SELECT SUM(i.total_cents) FROM invoices i WHERE i.project_id = p.id AND i.status != 'void'), 0) AS invoiced_cents,
  COALESCE((SELECT SUM(pay.amount_cents) FROM payments pay WHERE pay.project_id = p.id), 0) AS paid_cents
  FROM projects p JOIN users u ON u.id = p.client_user_id WHERE p.id = ?1 LIMIT 1`).bind(id).first<ProjectSummary>();
if (!project) return new Response('Project not found', { status: 404 });
const [worklogsResult, eventsResult, documentsResult, invoicesResult, paymentsResult] = await Promise.all([
  db.prepare('SELECT * FROM worklogs WHERE project_id = ?1 ORDER BY worked_on DESC, created_at DESC').bind(project.id).all<WorklogRow>(),
  db.prepare('SELECT * FROM timeline_events WHERE project_id = ?1 ORDER BY occurred_at DESC').bind(project.id).all<{ id: string; kind: string; title: string; body: string; visibility: string; occurred_at: number }>(),
  db.prepare('SELECT id, project_id, kind, title, original_filename, mime_type, size_bytes, period, created_at FROM documents WHERE project_id = ?1 ORDER BY created_at DESC').bind(project.id).all<DocumentRow>(),
  db.prepare(`SELECT i.*, COALESCE((SELECT SUM(p.amount_cents) FROM payments p WHERE p.invoice_id = i.id), 0) AS paid_cents FROM invoices i WHERE i.project_id = ?1 ORDER BY period_start DESC`).bind(project.id).all<InvoiceRow>(),
  db.prepare('SELECT p.*, i.number AS invoice_number FROM payments p LEFT JOIN invoices i ON i.id = p.invoice_id WHERE p.project_id = ?1 ORDER BY paid_on DESC').bind(project.id).all<{ id: string; invoice_number: string | null; amount_cents: number; paid_on: string; method: string; reference: string }>(),
]);
const today = new Date().toISOString().slice(0, 10);
const flash = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const accrued = Math.round(project.worked_minutes * project.hourly_rate_cents / 60);
---
<AppLayout title={`${project.name} — Studio`}>
  <AppShell title={project.name} subtitle={`${project.client_name} / ${project.client_email}`} {principal} mode="admin">
    {flash && <p class="flash" role="status">Saved: {flash.replaceAll('-', ' ')}.</p>}
    {error && <p class="flash form-error" role="alert">Could not save. Review the values and try again.</p>}
    <div class="workspace">
      <section class="app-section">
        <div class="app-section-header"><h2>Project ledger</h2><p><a class="text-link" href="/admin">← All projects</a></p></div>
        <dl class="metric-ledger">
          <div class="metric"><dt>Worked</dt><dd>{formatHours(project.worked_minutes)}</dd></div>
          <div class="metric"><dt>Estimated</dt><dd>{formatHours(project.estimated_minutes)}</dd></div>
          <div class="metric"><dt>Accrued</dt><dd>{formatMoney(accrued)}</dd></div>
          <div class="metric"><dt>Received</dt><dd>{formatMoney(project.paid_cents)}</dd></div>
        </dl>
      </section>

      <div class="admin-grid">
        <section class="app-section">
          <div class="app-section-header"><h2>Add work</h2><p>Visible + private record</p></div>
          <form class="editor-form" method="post" action="/api/admin/worklogs">
            <input type="hidden" name="project_id" value={project.id} />
            <div class="field"><label for="worked_on">Date</label><input id="worked_on" name="worked_on" type="date" value={today} required /></div>
            <div class="field"><label for="hours">Hours</label><input id="hours" name="hours" type="number" min="0.25" max="24" step="0.25" required /></div>
            <div class="field span-2"><label for="category">Category</label><select id="category" name="category"><option value="strategy">Strategy</option><option value="design">Design</option><option value="development">Development</option><option value="meeting">Meeting</option><option value="content">Content</option><option value="maintenance">Maintenance</option></select></div>
            <div class="field span-2"><label for="public_note">Client-visible note</label><textarea id="public_note" name="public_note" required></textarea></div>
            <div class="field span-2"><label for="private_note">Private studio note</label><textarea id="private_note" name="private_note"></textarea></div>
            <button type="submit">Add work entry</button>
          </form>
        </section>

        <section class="app-section">
          <div class="app-section-header"><h2>Add timeline update</h2><p>Milestones beyond hours</p></div>
          <form class="editor-form" method="post" action="/api/admin/timeline">
            <input type="hidden" name="project_id" value={project.id} />
            <div class="field"><label for="kind">Kind</label><select id="kind" name="kind"><option value="update">Update</option><option value="milestone">Milestone</option><option value="decision">Decision</option><option value="delivery">Delivery</option></select></div>
            <div class="field"><label for="occurred_on">Date</label><input id="occurred_on" name="occurred_on" type="date" value={today} required /></div>
            <div class="field span-2"><label for="title">Title</label><input id="title" name="title" required /></div>
            <div class="field span-2"><label for="body">Details</label><textarea id="body" name="body"></textarea></div>
            <div class="field span-2"><label for="visibility">Visibility</label><select id="visibility" name="visibility"><option value="public">Client + studio</option><option value="private">Studio only</option></select></div>
            <button type="submit">Add timeline entry</button>
          </form>
        </section>
      </div>

      <section class="app-section">
        <div class="app-section-header"><h2>Work history</h2><p>{worklogsResult.results.length} entries</p></div>
        {worklogsResult.results.length ? <table class="ledger-table"><thead><tr><th>Date</th><th>Category</th><th>Client-visible note</th><th>Private note</th><th class="align-right">Time</th></tr></thead><tbody>{worklogsResult.results.map((log) => <tr><td>{log.worked_on}</td><td>{log.category}</td><td>{log.public_note}</td><td>{log.private_note || '—'}</td><td class="align-right">{formatHours(log.minutes)}</td></tr>)}</tbody></table> : <div class="empty-state">No work has been logged.</div>}
      </section>

      <section class="app-section">
        <div class="app-section-header"><h2>Timeline entries</h2><p>Public and studio-only updates</p></div>
        {eventsResult.results.length ? <table class="ledger-table"><thead><tr><th>Date</th><th>Kind</th><th>Title</th><th>Visibility</th></tr></thead><tbody>{eventsResult.results.map((event) => <tr><td>{new Date(event.occurred_at * 1000).toISOString().slice(0, 10)}</td><td>{event.kind}</td><td>{event.title}</td><td><span class="status">{event.visibility}</span></td></tr>)}</tbody></table> : <div class="empty-state">No standalone timeline updates.</div>}
      </section>

      <div class="admin-grid">
        <section class="app-section">
          <div class="app-section-header"><h2>Create invoice</h2><p>EUR 40/hour snapshot</p></div>
          <form class="editor-form" method="post" action="/api/admin/invoices">
            <input type="hidden" name="project_id" value={project.id} />
            <div class="field"><label for="number">Invoice number</label><input id="number" name="number" required /></div>
            <div class="field"><label for="invoice_hours">Hours billed</label><input id="invoice_hours" name="hours" type="number" min="0" step="0.25" required /></div>
            <div class="field"><label for="period_start">Period start</label><input id="period_start" name="period_start" type="date" required /></div>
            <div class="field"><label for="period_end">Period end</label><input id="period_end" name="period_end" type="date" required /></div>
            <div class="field"><label for="issued_on">Issued</label><input id="issued_on" name="issued_on" type="date" value={today} required /></div>
            <div class="field"><label for="due_on">Due</label><input id="due_on" name="due_on" type="date" required /></div>
            <div class="field span-2"><label for="invoice_description">Line description</label><input id="invoice_description" name="description" value="Professional services" required /></div>
            <div class="field span-2"><label for="invoice_status">Status</label><select id="invoice_status" name="status"><option value="draft">Draft</option><option value="issued">Issued</option></select></div>
            <button type="submit">Create invoice</button>
          </form>
        </section>

        <section class="app-section">
          <div class="app-section-header"><h2>Record payment</h2><p>Money received</p></div>
          <form class="editor-form" method="post" action="/api/admin/payments">
            <input type="hidden" name="project_id" value={project.id} />
            <div class="field span-2"><label for="invoice_id">Invoice</label><select id="invoice_id" name="invoice_id"><option value="">No linked invoice</option>{invoicesResult.results.filter((invoice) => invoice.status !== 'void').map((invoice) => <option value={invoice.id}>{invoice.number} · {formatMoney(invoice.total_cents)}</option>)}</select></div>
            <div class="field"><label for="amount">Amount EUR</label><input id="amount" name="amount" type="number" min="0.01" step="0.01" required /></div>
            <div class="field"><label for="paid_on">Paid on</label><input id="paid_on" name="paid_on" type="date" value={today} required /></div>
            <div class="field"><label for="method">Method</label><input id="method" name="method" value="bank_transfer" required /></div>
            <div class="field"><label for="reference">Reference</label><input id="reference" name="reference" /></div>
            <button type="submit">Record payment</button>
          </form>
        </section>
      </div>

      <section class="app-section">
        <div class="app-section-header"><h2>Invoices</h2><p>{formatMoney(project.invoiced_cents)} total</p></div>
        {invoicesResult.results.length ? <table class="ledger-table"><thead><tr><th>Number</th><th>Period</th><th>Status</th><th class="align-right">Total</th><th class="align-right">Paid</th></tr></thead><tbody>{invoicesResult.results.map((invoice) => <tr><td>{invoice.number}</td><td>{invoice.period_start} → {invoice.period_end}</td><td><span class="status">{invoice.status}</span></td><td class="align-right">{formatMoney(invoice.total_cents)}</td><td class="align-right">{formatMoney(invoice.paid_cents)}</td></tr>)}</tbody></table> : <div class="empty-state">No invoices yet.</div>}
      </section>

      <section class="app-section">
        <div class="app-section-header"><h2>Payments</h2><p>{paymentsResult.results.length} received records</p></div>
        {paymentsResult.results.length ? <table class="ledger-table"><thead><tr><th>Date</th><th>Invoice</th><th>Method</th><th>Reference</th><th class="align-right">Amount</th></tr></thead><tbody>{paymentsResult.results.map((payment) => <tr><td>{payment.paid_on}</td><td>{payment.invoice_number || '—'}</td><td>{payment.method}</td><td>{payment.reference || '—'}</td><td class="align-right">{formatMoney(payment.amount_cents)}</td></tr>)}</tbody></table> : <div class="empty-state">No payments recorded.</div>}
      </section>

      <section class="app-section">
        <div class="app-section-header"><h2>Private documents</h2><p>PDF · max 10 MB</p></div>
        <form class="editor-form" method="post" action="/api/admin/documents" enctype="multipart/form-data">
          <input type="hidden" name="project_id" value={project.id} />
          <div class="field"><label for="document_title">Title</label><input id="document_title" name="title" required /></div>
          <div class="field"><label for="document_kind">Kind</label><select id="document_kind" name="kind"><option value="contract">Contract</option><option value="proposal">Proposal</option><option value="invoice">Invoice</option><option value="other">Other</option></select></div>
          <div class="field"><label for="period">Period (optional)</label><input id="period" name="period" type="month" /></div>
          <div class="field"><label for="file">PDF file</label><input id="file" name="file" type="file" accept="application/pdf,.pdf" required /></div>
          <button type="submit">Upload PDF</button>
        </form>
        {documentsResult.results.length ? <table class="ledger-table"><thead><tr><th>Title</th><th>Kind</th><th>Period</th><th class="align-right">File</th></tr></thead><tbody>{documentsResult.results.map((document) => <tr><td>{document.title}</td><td>{document.kind}</td><td>{document.period || '—'}</td><td class="align-right"><a class="text-link" href={`/documents/${document.id}`}>Download</a></td></tr>)}</tbody></table> : <div class="empty-state">No documents uploaded.</div>}
      </section>
    </div>
  </AppShell>
</AppLayout>

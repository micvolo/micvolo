---
export const prerender = false;
import PublicLayout from '@/layouts/PublicLayout.astro';
import SiteRail from '@/components/public/SiteRail.astro';
import AppShell from '@/components/app/AppShell.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { getProjects } from '@/lib/admin-data';
import {
  formatEuro,
  formatOre,
  monthlyTotals,
  projectRate,
  workedHours,
  workedLabel,
  type AdminProject,
} from '@/components/app/project-view';

const principal = Astro.locals.principal;
if (!principal) return Astro.redirect('/admin/login');
if (principal.role !== 'admin') return Astro.redirect('/portal');
const projects: AdminProject[] = await getProjects();
const months = monthlyTotals(projects);
const rateNote = projects.some((project) => projectRate(project) !== 40) ? 'ore lavorate × tariffa' : 'ore lavorate × 40 €/ora';
---
<PublicLayout title="Tutti i progetti">
  <SiteRail />
  <AppShell title="Tutti i progetti" subtitle={`${projects.length} progetti · ${principal.email}`}>
    <div class="workspace">
      <section class="app-section">
        <div class="app-section-header"><h2>Progetti</h2><p>Ore lavorate per progetto</p></div>
        {projects.length ? (
          <ol class="project-rows">
            {projects.map((project, index) => (
              <li>
                <span class="project-row-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="project-row-body">
                  <strong>{project.title}</strong>
                  {project.description && <small>{project.description}</small>}
                </span>
                <span class="project-row-hours">{workedLabel(workedHours(project))}</span>
                <a class="text-link link-with-arrow project-row-link" href={`/admin/projects/${project.slug}`}>Apri<ArrowIcon direction="right" /></a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty-state">Nessun progetto da mostrare.</p>
        )}
      </section>

      <section class="app-section">
        <div class="app-section-header"><h2>Andamento mensile</h2><p>{rateNote}</p></div>
        {months.length ? (
          <table class="ledger-table">
            <thead><tr><th scope="col">Mese</th><th scope="col" class="align-right">Ore</th><th scope="col" class="align-right">Ricavo</th></tr></thead>
            <tbody>
              {months.map((month) => (
                <tr>
                  <td>{month.label}</td>
                  <td class="align-right">{formatOre(month.hours)}</td>
                  <td class="align-right">{formatEuro(month.amount)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="empty-state">Nessuna ora lavorata finora.</p>
        )}
      </section>
    </div>
  </AppShell>
</PublicLayout>

<style>
  .project-rows { list-style: none; margin: 0; padding: 0; }
  .project-rows li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    gap: var(--s3);
    align-items: baseline;
    padding: var(--s3) 0;
    border-top: 1px solid var(--glass-edge);
  }
  .project-rows li:first-child { border-top: 0; }
  .project-row-index { color: var(--ink-3); font-size: var(--f-label); font-variant-numeric: tabular-nums; }
  .project-row-body { min-width: 0; display: grid; gap: 2px; }
  .project-row-body strong { font-weight: 600; }
  .project-row-body small { color: var(--ink-3); font-size: var(--f-small); line-height: 1.35; }
  .project-row-hours { color: var(--ink-2); font-size: var(--f-small); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .project-row-link { font-size: var(--f-small); white-space: nowrap; }
  @media (max-width: 640px) {
    .project-rows li { grid-template-columns: auto minmax(0, 1fr); }
    .project-row-hours, .project-row-link { grid-column: 2; justify-self: start; }
  }
</style>

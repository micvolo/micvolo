---
import PublicLayout from '@/layouts/PublicLayout.astro';
import SiteRail from '@/components/public/SiteRail.astro';
import ArchiveIndex from '@/components/public/ArchiveIndex.astro';
import { projects } from '@/lib/lab/projects';

const items = projects.map((project) => ({
  href: `/graphic-experiments/${project.id}`,
  title: project.title,
  description: project.description,
}));
---

<PublicLayout title="Graphic experiments" description="Interaction, typography and WebGL studies.">
  <SiteRail />
  <main id="main" class="stream">
    <ArchiveIndex
      title="Graphic experiments"
      intro="Small studies in code, motion and interaction. Open one and play with it."
      {items}
    />
  </main>
</PublicLayout>

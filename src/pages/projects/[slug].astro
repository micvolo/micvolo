---
import PublicLayout from '@/layouts/PublicLayout.astro';
import SiteRail from '@/components/public/SiteRail.astro';
import ProjectCase from '@/components/project-page/ProjectCase.astro';
import { getProjects, type Project } from '@/lib/projects';

interface Props {
  project: Project;
}
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---
<PublicLayout title={project.title} description={project.description}>
  <SiteRail />
  <main id="main" class="stream">
    <ProjectCase project={project} />
  </main>
</PublicLayout>

---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PublicLayout from '@/layouts/PublicLayout.astro';
import SiteRail from '@/components/public/SiteRail.astro';
import ProjectCase from '@/components/project-page/ProjectCase.astro';
import type { ProjectCase as ProjectCaseData } from '@/lib/project-page/cases';
import { projectCases } from '@/lib/project-page/cases';

interface Props {
  entry: CollectionEntry<'projects'>;
  projectCase: ProjectCaseData;
}
export async function getStaticPaths() {
  const casesBySlug = new Map(projectCases.map((projectCase) => [projectCase.slug, projectCase]));
  // collection slug → case/asset folder slug where they differ
  const caseSlugAliases: Record<string, string> = { 'origami-project': 'origami' };
  const caseSlug = (slug: string) => casesBySlug.has(slug) ? slug : caseSlugAliases[slug] ?? slug;
  const projects = await getCollection('projects', (entry) => casesBySlug.has(caseSlug(entry.data.slug ?? '')));
  return projects.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, projectCase: casesBySlug.get(caseSlug(entry.data.slug as string)) },
  }));
}

const { entry, projectCase } = Astro.props;
---
<PublicLayout title={entry.data.title} description={projectCase.description}>
  <SiteRail />
  <main id="main" class="stream">
    <ProjectCase title={entry.data.title} date={entry.data.date} url={entry.data.url} projectCase={projectCase} />
  </main>
</PublicLayout>

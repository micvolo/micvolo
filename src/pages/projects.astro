---
import { getEntry } from 'astro:content';
import PublicLayout from '@/layouts/PublicLayout.astro';
import SiteRail from '@/components/public/SiteRail.astro';
import ProjectGrid from '@/components/public/ProjectGrid.astro';
const settings = await getEntry('settings', 'settings');
if (!settings) throw new Error('Site settings are missing');
---
<PublicLayout title="Projects" description={settings.data.shortDescription}>
  <SiteRail />
  <main id="main" class="stream">
    {/* The visible site title lives in the rail, which collapses on mobile: keep a heading. */}
    <h1 class="sr-only">Projects</h1>
    <section aria-label="All projects">
      <ProjectGrid />
    </section>
  </main>
</PublicLayout>

---
import PublicLayout from '@/layouts/PublicLayout.astro';
import SiteRail from '@/components/public/SiteRail.astro';

const games = [
  { title: 'Camaleonte', description: 'A bluffing word game for groups. One player does not know the secret word.', href: '/table-games/camaleonte' },
  { title: 'Reazione a catena', description: 'A fast word-guessing game for teams. Sixty seconds, three skips.', href: '/table-games/reazione-a-catena' },
  { title: 'Graphic experiments', description: 'Small studies in code, motion and interaction. Open one and play with it.', href: '/graphic-experiments' },
];
---

<PublicLayout title="Table games" description="Playable party games by Michele Volonghi.">
  <SiteRail />
  <main id="main" class="stream">
    <section class="games-index" aria-label="Table games">
      <header class="games-index__header">
        <h1>Table games</h1>
        <p>Small party games. Open one and play with the people next to you.</p>
      </header>
      <ol class="games-index__list">
        {games.map((game, index) => (
          <li>
            <a class="lab-row" href={game.href}>
              <span class="lab-row__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="lab-row__body">
                <strong>{game.title}</strong>
                <small>{game.description}</small>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
  <style>
    .games-index { padding: clamp(var(--s4), 4vw, var(--s7)); }
    .games-index__header { display: grid; gap: var(--s2); max-width: 44rem; padding-bottom: var(--s4); }
    .games-index__header h1 { margin: 0; font-size: var(--f-lead); font-weight: 600; letter-spacing: -.01em; }
    .games-index__header p { max-width: 52ch; color: var(--ink-2); font-size: var(--f-body); line-height: 1.5; }
    .games-index__list { list-style: none; margin: 0; padding: 0; max-width: 44rem; }
    .games-index__list li + li { border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent); }
    .lab-row { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--s3); padding-block: var(--s3); }
    .lab-row__number { color: var(--ink-3); font-variant-numeric: tabular-nums; }
    .lab-row__body { display: grid; gap: 2px; }
    .lab-row__body strong { font-weight: 500; }
    .lab-row__body small { color: var(--ink-2); line-height: 1.45; }
    @media (hover: hover) { .lab-row:hover strong { color: var(--accent); } }
  </style>
</PublicLayout>
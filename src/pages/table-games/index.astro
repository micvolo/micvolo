---
import PublicLayout from '@/layouts/PublicLayout.astro';
import SiteRail from '@/components/public/SiteRail.astro';
import ArchiveIndex from '@/components/public/ArchiveIndex.astro';

const items = [
  { title: 'Camaleonte', description: 'A bluffing word game for groups. One player does not know the secret word.', href: '/table-games/camaleonte' },
  { title: 'Reazione a catena', description: 'A fast word-guessing game for teams. Sixty seconds, three skips.', href: '/table-games/reazione-a-catena' },
  { title: 'Graphic experiments', description: 'Small studies in code, motion and interaction. Open one and play with it.', href: '/graphic-experiments' },
];
---

<PublicLayout title="Table games" description="Playable party games by Michele Volonghi.">
  <SiteRail />
  <main id="main" class="stream">
    <ArchiveIndex
      title="Table games"
      intro="Small party games. Open one and play with the people next to you."
      {items}
    />
  </main>
</PublicLayout>

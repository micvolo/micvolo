---
import { env as cloudflareEnv } from 'cloudflare:workers';
export const prerender = false;
import PublicLayout from '@/layouts/PublicLayout.astro';
import SiteRail from '@/components/public/SiteRail.astro';
import AppShell from '@/components/app/AppShell.astro';
import ProjectPage from '@/components/app/ProjectPage.astro';
import { getProjects, type AdminProject } from '@/lib/admin/store';

const principal = Astro.locals.principal;
if (!principal) return Astro.redirect('/portal/login');
if (principal.role === 'admin') return Astro.redirect('/admin');
const db = cloudflareEnv.DB;
// The client sees exactly one project page; the account-to-project link lives in
// the database and the page content comes from the shared read-only data layer.
const link = await db.prepare('SELECT slug FROM projects WHERE client_user_id = ?1 LIMIT 1')
  .bind(principal.userId).first<{ slug: string }>();
const projects: AdminProject[] = await getProjects(db);
const project = projects.find((item) => item.slug === link?.slug);
---
<PublicLayout title={project?.title ?? 'Il tuo progetto'}>
  <SiteRail />
  <AppShell subtitle={principal.email}>
    <div class="workspace">
      {project ? <ProjectPage {project} /> : <p class="empty-state bare">Nessun progetto è collegato a questo account.</p>}
    </div>
  </AppShell>
</PublicLayout>

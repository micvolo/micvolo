---
import { env as cloudflareEnv } from 'cloudflare:workers';
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AppShell from '@/components/app/AppShell.astro';
import { formatHours, formatMoney, type ProjectSummary, type DocumentRow, type InvoiceRow, type TimelineRow } from '@/lib/db';
const principal = Astro.locals.principal;
if (!principal) return Astro.redirect('/portal/login');
if (principal.role === 'admin') return Astro.redirect('/admin');
const db = cloudflareEnv.DB;
const project = await db.prepare(`
  SELECT p.*, u.display_name AS client_name, u.email AS client_email,
    COALESCE((SELECT SUM(w.minutes) FROM worklogs w WHERE w.project_id = p.id), 0) AS worked_minutes,
    COALESCE((SELECT SUM(i.total_cents) FROM invoices i WHERE i.project_id = p.id AND i.status != 'void'), 0) AS invoiced_cents,
    COALESCE((SELECT SUM(pay.amount_cents) FROM payments pay WHERE pay.project_id = p.id), 0) AS paid_cents
  FROM projects p JOIN users u ON u.id = p.client_user_id WHERE p.client_user_id = ?1 LIMIT 1
`).bind(principal.userId).first<ProjectSummary>();
if (!project) return Astro.redirect('/portal/login?error=project');
const [timelineResult, documentsResult, invoicesResult] = await Promise.all([
  db.prepare(`
    SELECT id, occurred_at, kind, title, body, 'event' AS source, NULL AS minutes FROM timeline_events
      WHERE project_id = ?1 AND visibility = 'public'
    UNION ALL
    SELECT id, unixepoch(worked_on || ' 12:00:00') AS occurred_at, category AS kind,
      public_note AS title, '' AS body, 'worklog' AS source, minutes FROM worklogs WHERE project_id = ?1
    ORDER BY occurred_at DESC
  `).bind(project.id).all<TimelineRow>(),
  db.prepare('SELECT id, project_id, kind, title, original_filename, mime_type, size_bytes, period, created_at FROM documents WHERE project_id = ?1 ORDER BY created_at DESC')
    .bind(project.id).all<DocumentRow>(),
  db.prepare(`SELECT i.*, COALESCE((SELECT SUM(p.amount_cents) FROM payments p WHERE p.invoice_id = i.id), 0) AS paid_cents
    FROM invoices i WHERE i.project_id = ?1 AND i.status != 'void' ORDER BY i.period_start DESC`).bind(project.id).all<InvoiceRow>(),
]);
const timeline = timelineResult.results;
const documents = documentsResult.results;
const invoices = invoicesResult.results;
const progress = project.estimated_minutes ? Math.min(100, Math.round(project.worked_minutes / project.estimated_minutes * 100)) : 0;
const accrued = Math.round(project.worked_minutes * project.hourly_rate_cents / 60);
const outstanding = Math.max(0, project.invoiced_cents - project.paid_cents);
---
<AppLayout title={project.name}>
  <AppShell title={project.name} subtitle={`Status / ${project.status}`} {principal} mode="client">
    <div class="workspace">
      <section class="app-section">
        <div class="app-section-header"><h2>Project summary</h2><p>€40/hour · billed monthly</p></div>
        <dl class="metric-ledger">
          <div class="metric"><dt>Worked</dt><dd>{formatHours(project.worked_minutes)}</dd></div>
          <div class="metric"><dt>Estimate</dt><dd>{formatHours(project.estimated_minutes)}</dd></div>
          <div class="metric"><dt>Current cost</dt><dd>{formatMoney(accrued)}</dd></div>
          <div class="metric"><dt>Outstanding</dt><dd>{formatMoney(outstanding)}</dd></div>
        </dl>
        <div class="progress-track" role="progressbar" aria-label="Estimated hours completed" aria-valuemin="0" aria-valuemax="100" aria-valuenow={progress} title={`${progress}% of estimated hours`}><i style={`width:${progress}%`}></i></div>
      </section>

      <section class="app-section">
        <div class="app-section-header"><h2>Timeline</h2><p>{timeline.length} recorded updates</p></div>
        {timeline.length ? <ol class="timeline">{timeline.map((item) => <li><time datetime={new Date(item.occurred_at * 1000).toISOString()}>{new Date(item.occurred_at * 1000).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</time><div><h3>{item.title}</h3>{item.body && <p>{item.body}</p>}</div><span class="timeline-meta">{item.source === 'worklog' && item.minutes ? formatHours(item.minutes) : item.kind}</span></li>)}</ol> : <div class="empty-state">No updates yet. The first visible work entry will start this timeline.</div>}
      </section>

      <section class="app-section">
        <div class="app-section-header"><h2>Invoices & payments</h2><p>{formatMoney(project.paid_cents)} received</p></div>
        {invoices.length ? <table class="ledger-table"><thead><tr><th>Invoice</th><th>Period</th><th>Status</th><th class="align-right">Total</th><th class="align-right">Balance</th></tr></thead><tbody>{invoices.map((invoice) => <tr><td>{invoice.number}</td><td>{invoice.period_start} → {invoice.period_end}</td><td><span class="status">{invoice.status}</span></td><td class="align-right">{formatMoney(invoice.total_cents)}</td><td class="align-right">{formatMoney(Math.max(0, invoice.total_cents - invoice.paid_cents))}</td></tr>)}</tbody></table> : <div class="empty-state">No invoices have been issued for this project.</div>}
      </section>

      <section class="app-section">
        <div class="app-section-header"><h2>Documents</h2><p>Private PDFs</p></div>
        {documents.length ? <table class="ledger-table"><thead><tr><th>Document</th><th>Type</th><th>Period</th><th class="align-right">File</th></tr></thead><tbody>{documents.map((document) => <tr><td>{document.title}</td><td>{document.kind}</td><td>{document.period || '—'}</td><td class="align-right"><a class="text-link" href={`/documents/${document.id}`}>Download PDF</a></td></tr>)}</tbody></table> : <div class="empty-state">Contracts, proposals and invoices will appear here when they are ready.</div>}
      </section>
    </div>
  </AppShell>
</AppLayout>

---
import { env as cloudflareEnv } from 'cloudflare:workers';
export const prerender = false;
import AppLayout from '@/layouts/AppLayout.astro';
import AuthPanel from '@/components/app/AuthPanel.astro';
import { isDevelopment } from '@/lib/auth';
if (Astro.locals.principal?.role === 'client') return Astro.redirect('/portal');
const env = cloudflareEnv;
const preview = env.DEV_OTP_PREVIEW === 'true' && isDevelopment(env, Astro.url) && /^\d{6}$/.test(Astro.url.searchParams.get('preview') ?? '')
  ? Astro.url.searchParams.get('preview') ?? undefined
  : undefined;
---
<AppLayout title="Client access"><AuthPanel role="client" sent={Astro.url.searchParams.has('sent')} error={Astro.url.searchParams.has('error')} {preview} /></AppLayout>

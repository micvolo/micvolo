---
import '@/styles/site.css';
import { ClientRouter, fade } from 'astro:transitions';
import InteractionRuntime from '@/components/InteractionRuntime.astro';
import AmbientShader from '@/components/AmbientShader.astro';
import ogImage from '@/assets/og/homepage.webp';
interface Props { title?: string; description?: string; }
const {
  title,
  description = 'Web developer e programmatore freelance a Brescia. Siti web, e-commerce, web app, 3D e animazioni per aziende e studi, in Lombardia e da remoto.',
} = Astro.props;
const pageTitle = title ? `${title} — Michele Volonghi` : 'Michele Volonghi — Web Developer & Programmatore a Brescia';
---
<!doctype html>
<html lang="en" transition:name="root" transition:animate={fade({ duration: '0.22s' })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="Michele Volonghi" />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light dark" />
    <meta id="theme-color-light" name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta id="theme-color-dark" name="theme-color" content="#1e1e1e" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/sf-pro-text-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sf-pro-text-semibold.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="/theme.js"></script>
    <!-- Pre-paint scroll state (rail + homepage persistence). Must stay an external
         classic script: inline scripts are blocked by the `script-src 'self'` CSP. -->
    <script is:inline src="/nav-boot.js"></script>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content="Michele Volonghi" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:type" content="image/webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage.src, Astro.site)} />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" src="/person.schema.json"></script>
    <ClientRouter fallback="animate" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <AmbientShader />
    <!-- data-astro-reload: a same-page anchor is not a view transition. Without it the
         router jumps the scroll while Lenis smooths it; InteractionRuntime handles the
         click (focus + smooth scroll) instead. -->
    <a class="skip-link" href="#main" data-astro-reload>Skip to content</a>
    <div class="page shell-layout"><slot /></div>
    <InteractionRuntime />
  </body>
</html>
